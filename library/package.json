{
  "name": "@yanikkendler/web-utils",
  "version": "1.4.9",
  "description": "a collection of utility functions for web development in js/ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ./scripts/renameMjs.js",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run build:cjs && npm run build:esm && npm run docs",
    "docs": "(echo # API & echo. & echo ^<a name=\"root\"^>^</a^> & echo. & npx jsdoc2md \"dist/**/*.js\") > API.md"
  },
  "files": [
    "dist"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elYanuki/web-utils.git"
  },
  "author": "yanik kendler",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/elYanuki/web-utils/issues"
  },
  "homepage": "https://github.com/elYanuki/web-utils#readme",
  "devDependencies": {
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "typescript": "^5.9.3"
  }
}
